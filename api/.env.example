APP_NAME="Nador Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Langues : français par défaut, arabe et anglais disponibles.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL + PostGIS (conteneur Docker en local).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nadorcare
DB_USERNAME=nadorcare
DB_PASSWORD=nadorcare

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis. Depuis Windows : client predis et port 6380 (redirigé vers le conteneur).
# Dans les conteneurs, compose.yaml force phpredis et le port 6379.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Jetons d'API (Sanctum) : durée de vie en minutes (43200 = 30 jours).
SANCTUM_TOKEN_EXPIRATION=43200

# Codes OTP.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# Code fixe accepté pour tous les numéros. Ignoré en production. Laisser vide pour désactiver.
OTP_STATIC_CODE=

# Plafonds par compte, contre les abus.
LIMIT_PATIENT_PROFILES=10
LIMIT_ADDRESSES=20
LIMIT_REPORT_PHOTOS=10

# Version des documents légaux acceptés à la création du compte.
LEGAL_DOCUMENTS_VERSION=2026-11

# Chiffrement des fichiers de santé (clé base64 de 32 octets : php artisan nadorcare:files-key).
# Vide = repli sur APP_KEY, à éviter hors développement.
FILES_ENCRYPTION_KEY=
# Disque des fichiers privés : local en développement, s3 en production.
PRIVATE_FILES_DISK=local

# Stockage objet compatible S3 (production).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Services externes : "fake" tant que les contrats ne sont pas signés.
SMS_DRIVER=fake
WHATSAPP_DRIVER=fake
PUSH_DRIVER=fake
PAYMENT_DRIVER=fake
MAPS_DRIVER=fake

# Payzone (paiement carte) — à renseigner une fois le contrat signé.
PAYZONE_MERCHANT_ID=
PAYZONE_SECRET_KEY=
PAYZONE_BASE_URL=

# Passerelle SMS, WhatsApp Business, Firebase, Google Maps — à renseigner plus tard.
SMS_API_KEY=
SMS_SENDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FIREBASE_CREDENTIALS=
GOOGLE_MAPS_API_KEY=

# Reverb (WebSocket). Générer des valeurs propres à chaque environnement.
REVERB_APP_ID=nadorcare
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Documentation OpenAPI en ligne (/docs/api) : locale uniquement par défaut.
SCRAMBLE_ENABLED=true

SENTRY_LARAVEL_DSN=
