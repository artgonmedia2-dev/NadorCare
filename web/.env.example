# Adresse de l'API Laravel, vue depuis le serveur Next.js (jamais exposée au navigateur).
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Coordonnées affichées sur toutes les pages. Laisser vide tant qu'elles ne sont pas fixées :
# le bouton WhatsApp et le numéro d'appel ne s'affichent alors pas.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
